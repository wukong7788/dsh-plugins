{
  "name": "@ron777/dsh-printer",
  "version": "0.1.2",
  "description": "Add a Print button next to Copy on finalized assistant messages in DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "icon": "./icon.svg",
  "author": "ron777",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wukong7788/dsh-plugins.git",
    "directory": "dsh-printer"
  },
  "homepage": "https://github.com/wukong7788/dsh-plugins/tree/main/dsh-printer",
  "bugs": {
    "url": "https://github.com/wukong7788/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "print",
    "printer"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
